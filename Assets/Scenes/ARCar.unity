  exitInteriorButton: {fileID: 2072454986}
  hotspots:
  - anchor: {fileID: 1833727033}
    marker: {fileID: 189735134}
    button: {fileID: 189735135}
    title: "\u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C"
    body: "\u0410\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u043D\u044B\u0439 V8 \u043E\u0431\u044A\u0451\u043C\u043E\u043C 4,5 \u043B \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u0437\u0430 \u0441\u0438\u0434\u0435\u043D\u044C\u044F\u043C\u0438 (\u0441\u0440\u0435\u0434\u043D\u0435\u043C\u043E\u0442\u043E\u0440\u043D\u0430\u044F \u043A\u043E\u043C\u043F\u043E\u043D\u043E\u0432\u043A\u0430).\n\n\u2022 \u041C\u043E\u0449\u043D\u043E\u0441\u0442\u044C: 570 \u043B. \u0441. \u043F\u0440\u0438 9000 \u043E\u0431/\u043C\u0438\u043D\n\u2022 \u041A\u0440\u0443\u0442\u044F\u0449\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442: 540 \u041D\xB7\u043C\n\u2022 \u041A\u043E\u0440\u043E\u0431\u043A\u0430: 7-\u0441\u0442\u0443\u043F\u0435\u043D\u0447\u0430\u0442\u044B\u0439 \u0440\u043E\u0431\u043E\u0442 \u0441 \u0434\u0432\u0443\u043C\u044F \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u044F\u043C\u0438\n\u2022 \u041F\u0440\u0438\u0432\u043E\u0434: \u0437\u0430\u0434\u043D\u0438\u0439"
  - anchor: {fileID: 1833727032}
    marker: {fileID: 406244137}
    button: {fileID: 406244138}
    title: "\u041A\u043E\u043B\u0451\u0441\u0430 \u0438 \u0442\u043E\u0440\u043C\u043E\u0437\u0430"
    body: "20-\u0434\u044E\u0439\u043C\u043E\u0432\u044B\u0435 \u043A\u043E\u0432\u0430\u043D\u044B\u0435 \u0434\u0438\u0441\u043A\u0438.\n\n\u2022 \u0428\u0438\u043D\u044B \u0441\u043F\u0435\u0440\u0435\u0434\u0438: 235/35 ZR20\n\u2022 \u0428\u0438\u043D\u044B \u0441\u0437\u0430\u0434\u0438: 295/35 ZR20\n\u2022 \u0422\u043E\u0440\u043C\u043E\u0437\u0430: \u043A\u0430\u0440\u0431\u043E\u043D-\u043A\u0435\u0440\u0430\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0434\u0438\u0441\u043A\u0438\n\n\u0426\u0432\u0435\u0442 \u0434\u0438\u0441\u043A\u043E\u0432 \u043C\u043E\u0436\u043D\u043E \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \xAB\u0414\u0438\u0441\u043A\u0438\xBB."
  - anchor: {fileID: 1833727031}
    marker: {fileID: 1749946895}
    button: {fileID: 1749946896}
    title: "\u0421\u0430\u043B\u043E\u043D"
    body: "\u0414\u0432\u0443\u0445\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0441\u0430\u043B\u043E\u043D, \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043D\u0430 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F: \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043E\u0440\u0433\u0430\u043D\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u044B\u043D\u0435\u0441\u0435\u043D\u044B \u043D\u0430 \u0440\u0443\u043B\u044C, \u043A\u0430\u043A \u0432 \u0431\u043E\u043B\u0438\u0434\u0435 \u0424\u043E\u0440\u043C\u0443\u043B\u044B-1.\n\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0421\u0430\u043B\u043E\u043D\xBB, \u0447\u0442\u043E\u0431\u044B \u0441\u0435\u0441\u0442\u044C \u0437\u0430 \u0440\u0443\u043B\u044C \u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F."
  - anchor: {fileID: 1833727030}
    marker: {fileID: 1956083115}
    button: {fileID: 1956083116}
    title: "\u0424\u0430\u0440\u044B"
    body: "\u0411\u0438\u043A\u0441\u0435\u043D\u043E\u043D\u043E\u0432\u044B\u0435 \u0444\u0430\u0440\u044B \u0441 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0431\u043B\u043E\u043A\u0430\u043C\u0438 \u0441\u0432\u0435\u0442\u043E\u0434\u0438\u043E\u0434\u043D\u044B\u0445 \u0445\u043E\u0434\u043E\u0432\u044B\u0445 \u043E\u0433\u043D\u0435\u0439.\n\n\u041A\u043D\u043E\u043F\u043A\u0430 \xAB\u0424\u0430\u0440\u044B\xBB \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0441\u0432\u0435\u0442."
  - anchor: {fileID: 1833727029}
    marker: {fileID: 885680239}
    button: {fileID: 885680240}
    title: "\u041A\u0443\u0437\u043E\u0432 \u0438 \u0434\u0438\u043D\u0430\u043C\u0438\u043A\u0430"
    body: "\u0410\u043B\u044E\u043C\u0438\u043D\u0438\u0435\u0432\u044B\u0439 \u043A\u0443\u0437\u043E\u0432 \u0441\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0439 \u0436\u0451\u0441\u0442\u043A\u043E\u0439 \u043A\u0440\u044B\u0448\u0435\u0439, \u0434\u0438\u0437\u0430\u0439\u043D \u0430\u0442\u0435\u043B\u044C\u0435 Pininfarina.\n\n\u2022 \u0414\u043B\u0438\u043D\u0430 \xD7 \u0448\u0438\u0440\u0438\u043D\u0430 \xD7 \u0432\u044B\u0441\u043E\u0442\u0430: 4527 \xD7 1937 \xD7 1211 \u043C\u043C\n\u2022 \u041A\u043E\u043B\u0451\u0441\u043D\u0430\u044F \u0431\u0430\u0437\u0430: 2650 \u043C\u043C\n\u2022 \u0421\u0443\u0445\u0430\u044F \u043C\u0430\u0441\u0441\u0430: 1430 \u043A\u0433\n\u2022 \u0420\u0430\u0437\u0433\u043E\u043D 0\u2013100 \u043A\u043C/\u0447: 3,4 \u0441\n\u2022 \u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C: 320 \u043A\u043C/\u0447"
  infoCard: {fileID: 1977416733}
  infoTitle: {fileID: 784108454}
  infoBody: {fileID: 1701617183}
  infoCloseButton: {fileID: 1453530856}
